{
  "name": "rolling-design-sync",
  "version": "0.13.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Figma -> code change-sync service: a Figma plugin scans a scope for design changes, uploads a snapshot through an authenticated API, and worker agents pull a compact work queue and record verification.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node apps/api/src/server.js",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p .",
    "gen:types": "node scripts/gen-v3-types.js",
    "gen:types:check": "node scripts/gen-v3-types.js --check"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
