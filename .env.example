# ---------------------------------------------------------------------------
# rolling-design-sync — environment template
#
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# These are consumed by the API service (apps/api) and the agent CLI
# (scripts/). The Figma plugin does NOT read this file — its API base URL and
# upload token are entered in the plugin UI and kept in Figma clientStorage.
# ---------------------------------------------------------------------------

# === Database (Supabase Postgres) ==========================================
# Connection string from Supabase: Project Settings -> Database -> Connection string.
# - Always-on host (Railway/Render/Fly): use the DIRECT connection (port 5432).
# - Serverless host (Vercel/Edge):        use the POOLER connection (port 6543).
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Alternative to DATABASE_URL if the service uses the supabase-js client with
# the service-role key instead of a raw Postgres connection. Keep the
# service-role key SERVER-SIDE ONLY — it bypasses row-level security.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# === API service (apps/api) ================================================
PORT=8787
LOG_LEVEL=info

# Static bearer tokens accepted from the Figma plugin for snapshot uploads.
# Comma-separated so you can rotate / issue per-user tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Any entry may be name:token ([a-z0-9._-]{1,40}) so events name a person or
# worker instead of a hash, e.g. RDS_PLUGIN_TOKENS=maya:<token>,bot:<token>.
RDS_PLUGIN_TOKENS=

# Static bearer tokens accepted from worker agents for reading the queue and
# recording verification. Keep separate from the plugin tokens. Same
# name:token syntax.
RDS_AGENT_TOKENS=

# Read-only tokens (v3 GET routes only, including events and resolve) for
# dashboards and UIs. Writes with one are 403 wrong_token_class. Same
# name:token syntax.
RDS_VIEWER_TOKENS=

# Secret the browser sessions (/v3/session, the portal UI) sign their
# rds_session cookie with. Required for sessions in DATABASE_URL mode;
# RDS_STORE modes generate one into tokens.json on first start. Generate
# like a token.
RDS_SESSION_SECRET=

# Directory of the built portal the API serves at /ui. Defaults to
# apps/portal/dist resolved relative to this repo.
RDS_PORTAL_DIR=

# Embedded modes (RDS_STORE) only: browser UI origins allowed besides no
# Origin / `null`. Loopback only: http://localhost:<port> or
# http://127.0.0.1:<port>, comma-separated; anything else fails startup.
RDS_UI_ORIGINS=

# Rate limits: requests per minute per API instance, in fixed one-minute
# windows; 0 disables one. Defaults with DATABASE_URL: 600 per token, 120 per
# client IP without a token, 10 sign-ins + rejected tokens (401) per client IP. RDS_STORE modes
# default to 0 (off). Over a limit: 429 rate_limited with Retry-After.
RDS_RATE_LIMIT_TOKEN=600
RDS_RATE_LIMIT_IP=120
RDS_RATE_LIMIT_AUTH=10

# Take the client IP from X-Forwarded-For only behind a proxy you control
# (Railway/Render/Fly, nginx, Caddy): the number of proxy hops (1 for one
# platform router), `true` (every hop), or proxy addresses/CIDRs. Unset: the
# header is ignored and the socket address counts.
RDS_TRUST_PROXY=

# Live events (GET /v3/files/{fileKey}/events). LISTEN/NOTIFY needs a DIRECT
# connection: when DATABASE_URL is a transaction pooler (6543), set the direct
# (5432) URL here. Without it the API falls back to polling every 2 s.
RDS_LISTEN_URL=
# How far back a reconnecting stream replays (older cursors get `reset`), and
# how long events are kept.
RDS_EVENT_REPLAY_HOURS=24
RDS_EVENT_RETENTION_DAYS=30

# === Agent CLI (scripts/) ==================================================
# Base URL of the hosted API (platform subdomain or your custom CNAME).
RDS_API_BASE_URL=https://rds.example.com

# The single agent token this worker/CLI presents (one of RDS_AGENT_TOKENS).
RDS_AGENT_TOKEN=
